# AI Slice 环境变量配置
# 复制此文件为 .env 并填入实际值

# Database
DATABASE_URL=postgresql+asyncpg://slice:slice_dev@localhost:5433/ai_slice

# LLM（支持任意 OpenAI 兼容接口；以下示例使用阿里云百炼千问）
# API Key 只填写到本机 backend/.env，不要提交到 Git。
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# ASR：默认使用百炼千问文件转写；DASHSCOPE_API_KEY 留空时复用 LLM_API_KEY
ASR_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://ws-0kgg8uj9cl1pazrg.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_ASR_MODEL=qwen-audio-3.0-asr-flash-filetrans
DASHSCOPE_ASR_POLL_INTERVAL_SECONDS=3
DASHSCOPE_ASR_TIMEOUT_SECONDS=7200

# Groq ASR（可选回退，仅 ASR_PROVIDER=groq 时需要）
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo
GROQ_ASR_CHUNK_MINUTES=25

# Pipeline
TEMP_DIR=./tmp

# 后台 Worker 协程池大小（同时处理的任务数上限）
# 分析阶段主要等待 ASR / LLM 网络 I/O；请根据云端并发和速率限制调整
WORKER_CONCURRENCY=10

# 本地文件存储（上传的音频、临时本地导出文件等）
STORAGE_DIR=./storage

# 本地 FFmpeg 可执行文件目录（大文件本地导出需要；也可把 ffmpeg/ffprobe 加入 PATH）
FFMPEG_BIN_DIR=
